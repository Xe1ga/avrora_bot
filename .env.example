# ── VK ─────────────────────────────────────────────────────────────────────
# Ключ доступа сообщества (Управление → Настройки → Работа с API → Ключи доступа)
VK_TOKEN=vk1.a.REPLACE_ME
# Числовой ID сообщества (без "club")
VK_GROUP_ID=0

# Режим приёма событий: по умолчанию Long Poll. Callback пока выключен.
VK_USE_CALLBACK=false
# Заполняются только при VK_USE_CALLBACK=true
# VK_CONFIRMATION_TOKEN=
# VK_SECRET_KEY=

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=avrora_bot
POSTGRES_USER=avrora
POSTGRES_PASSWORD=change_me

# ── Шифрование персональных данных (ФИО, телефон) ──────────────────────────
# 32 байта в base64 (AES-256-GCM). Сгенерировать:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
PII_ENCRYPTION_KEY=

# ── Согласие на обработку персональных данных (ТЗ 3.6, 152-ФЗ) ─────────────
# Ссылки на страницы docs/legal/privacy-policy.html и docs/legal/consent.html.
# По умолчанию — GitHub Pages из /docs текущего репозитория (Settings →
# Pages → Source: Deploy from a branch → main /docs). Подставьте свои,
# если публикуете страницы иначе (свой домен, Cloudflare Pages и т.п.).
PRIVACY_POLICY_URL=https://xe1ga.github.io/avrora_bot/legal/privacy-policy.html
PDN_CONSENT_URL=https://xe1ga.github.io/avrora_bot/legal/consent.html
# Каталог с теми же файлами. При старте бот читает их, берёт версию из
# заголовка страницы («Версия X.Y от ...») и регистрирует её в таблице
# legal_documents вместе с полным текстом; на эти строки ссылается журнал
# согласий user_consents. Новая редакция = правка текста + новый номер
# версии в заголовке, отдельная переменная с версией не нужна.
LEGAL_DOCS_DIR=docs/legal

# ── Расписание (ТЗ 3.7) ─────────────────────────────────────────────────────
# docs/schedule.html, публикуется ссылкой в конце сообщения «Календарь».
# Обновляется вручную: scripts/build_schedule_page.py + git push.
SCHEDULE_URL=https://xe1ga.github.io/avrora_bot/schedule.html

# ── Bootstrap первого администратора ───────────────────────────────────────
# Ваш личный числовой vk_id: при старте бота получит роль admin.
BOOTSTRAP_ADMIN_VK_ID=

# ── Прочее ─────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_SEC=1.0
LOG_LEVEL=INFO
TZ=Europe/Moscow
