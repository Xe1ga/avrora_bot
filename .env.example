# ── VK ─────────────────────────────────────────────────────────────────────
# Ключ доступа сообщества (Управление → Настройки → Работа с API → Ключи доступа)
VK_TOKEN=vk1.a.REPLACE_ME
# Числовой ID сообщества (без "club")
VK_GROUP_ID=0

# Режим приёма событий: по умолчанию Long Poll. Callback пока выключен.
VK_USE_CALLBACK=false
# Заполняются только при VK_USE_CALLBACK=true
# VK_CONFIRMATION_TOKEN=
# VK_SECRET_KEY=

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=avrora_bot
POSTGRES_USER=avrora
POSTGRES_PASSWORD=change_me

# ── Шифрование персональных данных (ФИО, телефон) ──────────────────────────
# 32 байта в base64 (AES-256-GCM). Сгенерировать:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
PII_ENCRYPTION_KEY=

# ── Bootstrap первого администратора ───────────────────────────────────────
# Ваш личный числовой vk_id: при старте бота получит роль admin.
BOOTSTRAP_ADMIN_VK_ID=

# ── Прочее ─────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_SEC=1.0
LOG_LEVEL=INFO
TZ=Europe/Moscow
